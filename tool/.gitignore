# mcbot_tool runtime — never tracked
.runtime/

# harness driving sessions: event pulls, command logs, verdicts.
# Telemetry, not source; copy a verdict out explicitly to track it.
sessions/

# python
__pycache__/
*.pyc
*.pyo

# one-shot patch scripts produced by the agent during development
.tmp_*.py

# archive of finished one-shot patch scripts and per-session debug
# artifacts; never tracked, kept on disk for postmortem reference
_archive/
