<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Encodes the machine-checkable subset of AGENTS.md section 1 (code style)
  as checkstyle rules. Introduced 2026-08-27 alongside PMD; promoted from
  the -Plint suite into the default `test` flow the same day once the
  tree held zero violations (doc/guide/build-and-run.md carries postures).

  Deliberately NOT encoded here, each owned elsewhere:
  - final-everywhere (section 1.6): FinalParameters/FinalLocalVariable are
    too noisy at this codebase size; stays review-enforced.
  - CJK ban in Java sources: hygiene/EnglishOnlyScan.java already gates it.
  - Contract markers and wire vocabulary: BoundaryContractMarkerTest and
    the other src/test gates own those project-specific invariants.
  - Record/trailing-comma layout: no reliable AST mapping; review-enforced.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- Layout (indentation, brace presence, tab characters) is owned
         by Spotless + palantir-java-format since the 2026-08-27
         adoption; checking it here too would only re-litigate the
         formatter's output. This module still validates width. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="// width-120:"/>
    </module>

    <module name="TreeWalker">
        <!-- ===== naming (section 1.2 / 1.1) ===== -->
        <!-- modules are one lower-case word: com.mcbot.mcbotserver.<module>
             with no nesting of one module under another at the name level -->
        <module name="PackageName">
            <property name="format"
                      value="^com\.mcbot\.mcbotserver(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="RecordComponentName"/>

        <!-- ===== imports (section 1.3) =====
             Star imports forbidden; dead/self imports fail. Import ORDER
             is intentionally not checked in v1: the written rule ("IDE
             default alphabetical sort") and repo practice (blank-line
             grouped blocks) contradict each other; promoting an order
             gate needs a spec ruling first (doc/guide/build-and-run.md
             carries the follow-up note). -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- ===== javadoc presence + tags (section 1.4.2) =====
             public/protected types and members need Javadoc; non-void
             needs @return; every object param needs @param. Overridden
             methods are exempt by design. src/test/** is suppressed in
             suppressions.xml (test classes carry pragmatic coverage).
             JavadocStyle was dropped with the checkstyle 14 upgrade
             (2026-09-01, P3): upstream removed the module, and the
             first-sentence rule it partially enforced is review-owned
             per AGENTS.md section 1.2 anyway. -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
        </module>
        <!-- @param/@return tag completeness: was deferred at install
             (75 live gaps); cleared in the 2026-08-27 paydown round,
             enforced ever since. src/test/** stays exempt via
             suppressions.xml (pragmatic test coverage). -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
        </module>
        <!-- IllegalBlockTag for @author (new in checkstyle 13.10):
             AGENTS.md 1.4 bans author/date graffiti; the tree holds
             zero @author tags, so tagTextPattern ^$ makes any
             appearance a violation. -->
        <module name="IllegalBlockTag">
            <property name="tag" value="@author"/>
            <property name="tagTextPattern" value="^$"/>
        </module>
        <!-- Public constants need Javadoc: 29 public static final fields
             in api/ all carry docs today; this guards against bare
             constants leaking in. accessModifiers=public covers only
             public variables, so private/package constants are exempt. -->
        <module name="JavadocVariable">
            <property name="accessModifiers" value="public"/>
        </module>

        <!-- Layout mechanics retired to Spotless (see header comment at
             this file's top); what remains here are presence rules the
             formatter cannot own. -->
        <module name="ModifierOrder"/>
        <module name="SimplifyBooleanExpression"/>
        <!-- SimplifyBooleanReturn: `if (x) return true; else return false;`
             collapses to `return x;`. Zero-violation baseline verified
             2026-09-01; promoted as a regression guard alongside
             SimplifyBooleanExpression. -->
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="EqualsHashCode"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <!-- FallThrough: traditional switch statements must not drop
             through case labels without break/return/throw. Switch
             expressions (the project's dominant form) are fall-through-
             free by construction; this guards the day someone writes a
             statement switch. Zero-violation baseline 2026-09-01. -->
        <module name="FallThrough"/>
        <!-- UseEnhancedSwitch (new in checkstyle 13.3, adopted with the
             14.0.0 upgrade): a colon-label switch with no fall-through
             must be an arrow switch. Makes the arrow-style doctrine
             above mechanical - FallThrough guards the fall-through it
             permits, this bans the convertible form itself. Zero-
             violation baseline 2026-09-01 (whole tree incl. gametests
             is arrow-style). -->
        <module name="UseEnhancedSwitch"/>

        <!-- ===== record doctrine (section 1.2: records are the data
             carriers, sealed interfaces the sum types) =====
             JEP 395: an explicitly declared record accessor overrides
             the component's implicit accessor and must carry @Override.
             Zero explicit accessors in the tree today; guards the api
             sum-type hierarchies (Intent, SubmitResult, Goal) the day
             someone customizes one. New in checkstyle 13.1. -->
        <module name="MissingOverrideOnRecordAccessor"/>

        <!-- ===== banned types (obsolete JDK classes) =====
             java.util.Date -> java.time API; Vector/Hashtable/Stack ->
             modern Collections (ArrayList, HashMap, ArrayDeque). Zero
             usage in the tree today (scanned 2026-09-01); this is a
             regression guard, not a paydown target. -->
        <module name="IllegalType">
            <property name="illegalClassNames"
                      value="java.util.Date, java.util.Vector, java.util.Hashtable, java.util.Stack"/>
        </module>

        <!-- ===== exception hygiene (AGENTS.md 1.4 + crash-latch policy) =====
             IllegalCatch narrowed to Throwable/Exception/Error ONLY: the
             21 live catch(RuntimeException) sites are crash-latch
             defenses owned by ExceptionPolicyGateTest and must not be
             flagged. RuntimeException is deliberately absent from the
             list. IllegalThrows and MissingDeprecated are zero-hit
             guards today (no throws Exception, no @Deprecated). -->
        <module name="IllegalCatch">
            <property name="illegalClassNames"
                      value="java.lang.Throwable, java.lang.Exception, java.lang.Error"/>
        </module>
        <module name="IllegalThrows"/>
        <module name="MissingDeprecated"/>

        <!-- ===== TODO format (AGENTS.md 1.4: // TODO <subsystem>: <what> (Ref: <issue>)) =====
             Negative lookahead flags any TODO whose line does not carry
             both a <subsystem>: prefix and a (Ref: ...) clause. Multi-line
             TODOs must put (Ref:) on the first line so the per-line
             matcher sees it. -->
        <module name="TodoComment">
            <property name="format"
                      value="TODO(?!\s+\w+:\s.*\(Ref:)"/>
        </module>

        <!-- ===== banned anti-patterns (zero-hit guards today) =====
             printStackTrace() to stderr is banned: the one live site
             (BotController crash report) uses printStackTrace(PrintWriter)
             to capture into a string, which this regex does not match.
             System.exit() is banned: the mod never owns JVM lifecycle. -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="printStackTrace\(\)"/>
            <property name="message"
                      value="printStackTrace() to stderr is banned; use a logger or printStackTrace(Writer) to capture"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.exit\("/>
            <property name="message"
                      value="System.exit() is banned: the mod never owns JVM lifecycle"/>
        </module>
        <!-- Process-record guard: decision narratives ("ruling <year>",
             "Stage N review") belong in boundaries.md / the ledger /
             issues, never in production javadoc - javadoc keeps
             invariants and pointers (AGENTS.md 1.4). Evidence
             provenance ("dossier <date>", "decompiled <version>") is
             the sanctioned pointer style and stays allowed. src/test
             keeps pragmatic provenance via suppressions.xml. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="ProcessRecordGuard"/>
            <property name="format" value="ruling 20\d{2}|Stage \d review"/>
            <property name="message"
                      value="decision-process records belong in boundaries.md/ledger/issues; javadoc keeps invariants and pointers"/>
        </module>
    </module>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>
</module>
